+/*
+ * ZxR: after the DSP starts, it sometimes misses the start-up state of the
+ * centre/LFE (0x03) and surround (0x04) converter amps, and then keeps any mix
+ * of the centre, LFE and rear right outputs silent. It only applies those amps
+ * when they change, and the amp cache skips writes of unchanged values, so
+ * mute and restore them once the DSP is running. Doing it at the end of
+ * ca0132_init() is too early.
+ */
+static void zxr_wake_surround_outputs(struct hda_codec *codec)
+{
+	static const hda_nid_t nids[] = { 0x03, 0x04 };
+	unsigned int i, ch, side, val[ARRAY_SIZE(nids)][2];
+
+	for (i = 0; i < ARRAY_SIZE(nids); i++)
+		for (ch = 0; ch < 2; ch++) {
+			side = AC_AMP_SET_OUTPUT |
+			       (ch ? AC_AMP_SET_RIGHT : AC_AMP_SET_LEFT);
+			val[i][ch] = snd_hda_codec_amp_read(codec, nids[i], ch,
+							    HDA_OUTPUT, 0);
+			snd_hda_codec_write(codec, nids[i], 0,
+					    AC_VERB_SET_AMP_GAIN_MUTE,
+					    side | val[i][ch] | HDA_AMP_MUTE);
+		}
+	msleep(100);
+	for (i = 0; i < ARRAY_SIZE(nids); i++)
+		for (ch = 0; ch < 2; ch++) {
+			side = AC_AMP_SET_OUTPUT |
+			       (ch ? AC_AMP_SET_RIGHT : AC_AMP_SET_LEFT);
+			snd_hda_codec_write(codec, nids[i], 0,
+					    AC_VERB_SET_AMP_GAIN_MUTE,
+					    side | val[i][ch]);
+		}
+	codec_info(codec, "ZxR: centre/LFE/surround outputs re-sent\n");
+}
+
+static void zxr_wake_outputs_delayed(struct work_struct *work)
+{
+	struct ca0132_spec *spec = container_of(to_delayed_work(work),
+						struct ca0132_spec, zxr_wake_work);
+
+	CLASS(snd_hda_power_pm, pm)(spec->codec);
+	zxr_wake_surround_outputs(spec->codec);
+}
+
+/* Cancelled on suspend, so this is also re-armed when a resume finds the DSP loaded. */
+static void zxr_schedule_wake(struct ca0132_spec *spec)
+{
+	if (ca0132_quirk(spec) == QUIRK_ZXR && zxr_wake_outputs)
+		mod_delayed_work(system_wq, &spec->zxr_wake_work,
+				 msecs_to_jiffies(zxr_wake_delay_ms));
+}
