+/*
+ * Reads back the surround DAC setup. Returns the number of values that
+ * differ from what zxr_pre_dsp_setup() wrote, and logs them all.
+ */
+static int zxr_check_surround(struct hda_codec *codec, const char *when)
+{
+	struct ca0132_spec *spec = codec->spec;
+	unsigned int ret, v[ARRAY_SIZE(zxr_pll_addr)];
+	unsigned int i;
+	int bad = 0;
+
+	scoped_guard(mutex, &spec->chipio_mutex) {
+		chipio_8051_read_exram(codec, 0xfa92, &ret);
+		ret &= 0xff;
+		for (i = 0; i < ARRAY_SIZE(zxr_pll_addr); i++)
+			v[i] = zxr_read_pll_pmu(codec, zxr_pll_addr[i]);
+	}
+	if (ret != 0x22)
+		bad++;
+	for (i = 0; i < ARRAY_SIZE(zxr_pll_addr); i++)
+		if (v[i] != zxr_pll_data[i])
+			bad++;
+	codec_info(codec, "ZxR surround setup %s: %s (exram fa92=%02x pll 51=%02x 43=%02x 40=%02x 41=%02x 42=%02x 45=%02x)\n",
+		   when, bad ? "CHANGED" : "ok", ret, v[0], v[1], v[2], v[3], v[4], v[5]);
+	return bad;
+}
+
+/* Puts the surround DAC configuration back after the DSP has started. */
+static void zxr_reapply_surround(struct hda_codec *codec)
+{
+	unsigned int i;
+
+	chipio_8051_write_exram(codec, 0xfa92, 0x22);
+	snd_hda_codec_write(codec, WIDGET_CHIP_CTRL, 0, 0x725, 0x82);
+	chipio_set_control_param(codec, CONTROL_PARAM_ASI, 3);
+	for (i = 0; i < ARRAY_SIZE(zxr_pll_addr); i++)
+		chipio_8051_write_pll_pmu(codec, zxr_pll_addr[i], zxr_pll_data[i]);
+}
+
+/*
+ * Reads back the DSP output stream's (0x0c) port table in the ChipIO audio
+ * router and compares it with the ZxR remap (stream_remap_data[2]). Returns
+ * the number of wrong entries, or -1 if the stream has no ports.
+ */
+static int zxr_check_remap(struct hda_codec *codec, const char *when)
+{
+	struct ca0132_spec *spec = codec->spec;
+	const struct chipio_stream_remap_data *rd = &stream_remap_data[2];
+	unsigned int base, v[12], i;
+	int bad = 0;
+
+	scoped_guard(mutex, &spec->chipio_mutex)
+		chipio_8051_read_exram(codec, 0x1578 + rd->stream_id, &base);
+	base &= 0xff;
+	if (base == 0xff) {
+		codec_info(codec, "ZxR DSP output ports %s: stream 0x0c has no ports\n", when);
+		return -1;
+	}
+	for (i = 0; i < ARRAY_SIZE(v); i++)
+		if (chipio_read(codec, 0x190000 + base * 4 + i * 4, &v[i]) < 0)
+			v[i] = 0xffffffff;
+	for (i = 0; i < rd->count; i++)
+		if (v[rd->offset[i] / 4] != rd->value[i])
+			bad++;
+	codec_info(codec, "ZxR DSP output ports %s: %s (base %02x: %05x %05x %05x %05x %05x %05x %05x %05x %05x %05x %05x %05x)\n",
+		   when, bad ? "WRONG" : "ok", base, v[0], v[1], v[2], v[3], v[4], v[5],
+		   v[6], v[7], v[8], v[9], v[10], v[11]);
+	return bad;
+}
+
+static void zxr_post_dsp_surround_check(struct hda_codec *codec)
+{
+	struct ca0132_spec *spec = codec->spec;
+
+	if (!zxr_surround_fix)
+		return;
+	if (zxr_check_remap(codec, "after DSP start") > 0) {
+		scoped_guard(mutex, &spec->chipio_mutex)
+			chipio_remap_stream(codec, &stream_remap_data[2]);
+		msleep(20);
+		zxr_check_remap(codec, "after repair");
+	}
+	if (zxr_check_surround(codec, "after DSP start")) {
+		zxr_reapply_surround(codec);
+		msleep(20);
+		zxr_check_surround(codec, "after repair");
+	}
+}
