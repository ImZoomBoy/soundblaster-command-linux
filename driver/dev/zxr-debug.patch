+/* chipio_write() that retries on timeout and counts failures. */
+static void zxr_chipio_write_checked(struct hda_codec *codec,
+		unsigned int addr, unsigned int data, unsigned int *fails)
+{
+	int i, err = 0;
+
+	for (i = 0; i < 3; i++) {
+		err = chipio_write(codec, addr, data);
+		if (!err)
+			return;
+		codec_warn(codec, "ZxR surround setup: write %06x=%08x failed (%d), try %d\n",
+			   addr, data, err, i + 1);
+		msleep(50);
+	}
+	(*fails)++;
+}
+
+static unsigned int zxr_read_pll_pmu(struct hda_codec *codec, unsigned int addr)
+{
+	chipio_8051_set_address(codec, addr & 0xff);
+	return snd_hda_codec_read(codec, WIDGET_CHIP_CTRL, 0,
+				  VENDOR_CHIPIO_PLL_PMU_READ, 0) & 0xff;
+}
