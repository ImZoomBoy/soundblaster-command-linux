+/*
+ * Temporary debug hook (local patch, for comparing with the Windows capture):
+ * root writes a command to /sys/module/snd_hda_codec_ca0132/parameters/zxr_debug.
+ *   scp MOD REQ VAL      set a DSP parameter (hex, VAL as raw 32-bit)
+ *   scpget MOD REQ       read a DSP parameter (logged)
+ *   chipw ADDR VAL       ChipIO memory write;  chipr ADDR   read (logged)
+ *   gpio PIN 0|1         card GPIO (BAR2 0x320)
+ *   pll ADDR VAL         8051 PLL/PMU write;   exram ADDR VAL   8051 XRAM write
+ *   param ID VAL         ChipIO control parameter; connrate ID RATE
+ *   dumpx START COUNT    log 8051 XRAM bytes; dumpp 0   log PLL/PMU regs 00-ff
+ *   dumpc START COUNT    log ChipIO words (COUNT words from START)
+ *   verb CADNID VERB PAYLOAD   send an HDA verb to any codec on the card,
+ *                        e.g. "verb 20b 70c 2" = codec 2, node 0x0b, EAPD on
+ *   verbr CADNID VERB PAYLOAD  the same for a get verb (reply logged)
+ */
+static struct hda_codec *zxr_debug_find_codec(struct hda_codec *codec,
+					      unsigned int addr)
+{
+	struct hda_codec *c;
+
+	list_for_each_codec(c, codec->bus)
+		if (c->core.addr == addr)
+			return c;
+	return NULL;
+}
+
+static void zxr_debug_dump(struct hda_codec *codec, char kind,
+			   unsigned int start, unsigned int count)
+{
+	struct ca0132_spec *spec = codec->spec;
+	unsigned int i, j, v, per = kind == 'c' ? 8 : 32;
+	char line[8 + 32 * 3 + 1];
+	int len;
+
+	for (i = 0; i < count; i += per) {
+		len = 0;
+		for (j = 0; j < per && i + j < count; j++) {
+			if (kind == 'c') {
+				chipio_read(codec, start + (i + j) * 4, &v);
+				len += scnprintf(line + len, sizeof(line) - len, " %08x", v);
+				continue;
+			}
+			scoped_guard(mutex, &spec->chipio_mutex) {
+				if (kind == 'x')
+					chipio_8051_read_exram(codec, start + i + j, &v);
+				else
+					v = zxr_read_pll_pmu(codec, start + i + j);
+			}
+			len += scnprintf(line + len, sizeof(line) - len, " %02x", v & 0xff);
+		}
+		codec_info(codec, "zxr_dump %c %06x:%s\n", kind,
+			   kind == 'c' ? start + i * 4 : start + i, line);
+	}
+}
