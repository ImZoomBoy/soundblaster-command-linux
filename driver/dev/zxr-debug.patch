+static int zxr_debug_set(const char *val, const struct kernel_param *kp)
+{
+	struct hda_codec *codec = zxr_debug_codec;
+	unsigned int a = 0, b = 0, c = 0, reply = 0, reply_len = sizeof(reply);
+	char cmd[16];
+	int n;
+
+	if (!codec)
+		return -ENODEV;
+	n = sscanf(val, "%15s %x %x %x", cmd, &a, &b, &c);
+	if (n < 2)
+		return -EINVAL;
+	CLASS(snd_hda_power_pm, pm)(codec);
+	if (n >= 4 && !strcmp(cmd, "scp")) {
+		dspio_set_uint_param(codec, a, b, c);
+	} else if (n >= 3 && !strcmp(cmd, "scpget")) {
+		dspio_scp(codec, a, 0x20, b, SCP_GET, NULL, 0, &reply, &reply_len);
+		codec_info(codec, "zxr_debug: scp %02x/%02x = %08x\n", a, b, reply);
+		return 0;
+	} else if (n >= 3 && !strcmp(cmd, "chipw")) {
+		chipio_write(codec, a, b);
+	} else if (n >= 2 && !strcmp(cmd, "chipr")) {
+		chipio_read(codec, a, &reply);
+		codec_info(codec, "zxr_debug: chip %06x = %08x\n", a, reply);
+		return 0;
+	} else if (n >= 3 && !strcmp(cmd, "gpio")) {
+		ca0113_mmio_gpio_set(codec, a, b);
+	} else if (n >= 3 && !strcmp(cmd, "pll")) {
+		chipio_8051_write_pll_pmu(codec, a, b);
+	} else if (n >= 3 && !strcmp(cmd, "exram")) {
+		chipio_8051_write_exram(codec, a, b);
+	} else if (n >= 3 && !strcmp(cmd, "param")) {
+		chipio_set_control_param(codec, a, b);
+	} else if (n >= 2 && !strcmp(cmd, "skipexit")) {
+		zxr_skip_exit = !!a;
+	} else if (n >= 2 && !strcmp(cmd, "desktopfw")) {
+		zxr_desktop_fw = !!a;
+	} else if (n >= 2 && !strcmp(cmd, "winmmio")) {
+		zxr_windows_mmio = !!a;
+	} else if (n >= 2 && !strcmp(cmd, "eapdfix")) {
+		zxr_eapd_fix = !!a;
+	} else if (n >= 2 && !strcmp(cmd, "wake")) {
+		zxr_wake_outputs = !!a;
+	} else if (n >= 2 && !strcmp(cmd, "wakenow")) {
+		zxr_wake_surround_outputs(codec);
+	} else if (n >= 2 && !strcmp(cmd, "settle")) {
+		zxr_dsp_settle_ms = a;
+	} else if (n >= 2 && !strcmp(cmd, "streamgap")) {
+		zxr_stream_gap_ms = a;
+	} else if (n >= 3 && !strcmp(cmd, "connrate")) {
+		chipio_set_conn_rate(codec, a, b);
+	} else if (n >= 3 && !strcmp(cmd, "dumpx") && a + b <= 0x10000) {
+		zxr_debug_dump(codec, 'x', a, b);
+	} else if (n >= 2 && !strcmp(cmd, "dumpp")) {
+		zxr_debug_dump(codec, 'p', 0, 0x100);
+	} else if (n >= 3 && !strcmp(cmd, "dumpc") && b <= 0x400) {
+		zxr_debug_dump(codec, 'c', a, b);
+	} else if (n >= 4 && (!strcmp(cmd, "verb") || !strcmp(cmd, "verbr"))) {
+		struct hda_codec *tc = zxr_debug_find_codec(codec, (a >> 8) & 0xf);
+
+		if (!tc || b > 0xfff || c > 0xffff)
